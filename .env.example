# General
FLIGHTOPS_ENV=local
FLIGHTOPS_LOG_LEVEL=INFO

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=15432
POSTGRES_DB=postgres
POSTGRES_USER=flightops_admin
POSTGRES_PASSWORD=change-me
POSTGRES_PROJECT_USER=flightops_app
POSTGRES_PROJECT_PASSWORD=change-me

# MLflow
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=flight-delay-risk
MLFLOW_PORT=5000

# Airflow local metadata and UI
AIRFLOW_PORT=8080
AIRFLOW_FERNET_KEY=replace-with-a-generated-fernet-key
AIRFLOW_WEBSERVER_SECRET_KEY=replace-with-a-random-webserver-secret
AIRFLOW_ADMIN_USERNAME=flightops_admin
AIRFLOW_ADMIN_PASSWORD=change-me-airflow
AIRFLOW_ADMIN_EMAIL=flightops_admin@local.test

# Training
BASELINE_RUN_NAME=candidate-local
OPTUNA_TRIALS=40

# MinIO local artifact store
MINIO_ROOT_USER=flightops_minio
MINIO_ROOT_PASSWORD=change-me-minio
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# API
API_HOST=0.0.0.0
API_PORT=8000

# Observability
PROMETHEUS_PORT=9090
GRAFANA_PORT=3300
GRAFANA_ADMIN_USER=flightops_admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana
ALERTMANAGER_PORT=9093
